# start.sh generates unique credentials if .env is missing. No shared default password.
ADMIN_EMAIL=admin@zupirus.local
ADMIN_PASSWORD=
FEED_TOKEN=
# replay = localhost only; public = HTTPS on both supplied domains
DEPLOY_MODE=replay
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,https://zupirus.com,https://adm.zupirus.com
ACME_EMAIL=admin@zupirus.com
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Used only by optional Windows feed service:
API_URL=https://zupirus.com
MT5_SYMBOL=XAUUSD
