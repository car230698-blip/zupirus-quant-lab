# ZUPIRUS Quant Lab - Cấu hình môi trường mẫu (.env.example)
# Chế độ thực thi: chỉ cho phép SIMULATION_ONLY trong bản nghiệm thu
EXECUTION_MODE="SIMULATION_ONLY"

# Cổng lắng nghe nội bộ của ứng dụng (Mặc định 3000 trong container/dev; ánh xạ ra 127.0.0.1:3100 trên VPS qua Docker Compose)
PORT="3000"
HOST="127.0.0.1"

# Đường dẫn thư mục lưu trữ bền vững (trạng thái hệ thống, nhật ký sự kiện, lịch sử học)
DATA_DIR="./data/runtime"

# Đường dẫn file dữ liệu phát lại XAUUSD M15 xác định
REPLAY_FILE="./data/xauusd_m15_replay.json"

# Nhịp chạy tự động của bộ phát lại (mili-giây mỗi nến M15 trong mô phỏng; mặc định 800ms để quan sát trọn vòng trong khoảng 58 giây)
REPLAY_INTERVAL_MS="800"

# Tự động khởi chạy vòng lặp ngay khi server bật
AUTO_START_LOOP="true"

APP_URL="http://127.0.0.1:3100"
