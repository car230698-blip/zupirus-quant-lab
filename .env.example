# ==============================================================================
# ZUPIRUS Quant Lab — Environment Configuration Template
# ==============================================================================

# --- Core Application Environment ---
APP_ENV=production
DEPLOY_MODE=docker
API_URL=https://app.zupirus.com
ALLOWED_ORIGINS=https://zupirus.com,https://www.zupirus.com,https://app.zupirus.com,https://adm.zupirus.com
COOKIE_SECURE=true
ACME_EMAIL=admin@zupirus.com

# --- Database & Cache ---
POSTGRES_DB=zupirus_quant
POSTGRES_USER=zupirus
POSTGRES_PASSWORD=your_strong_postgres_password_here
DATABASE_URL=postgresql://zupirus:your_strong_postgres_password_here@timescaledb:5432/zupirus_quant
# REDIS_PASSWORD is required in production (compose.prod.yaml enforces non-empty value)
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_URL=redis://:your_strong_redis_password_here@redis:6379/0

# --- Security & Master Keys ---
ENCRYPTION_KEY=your_64char_master_encryption_key_here
ADMIN_EMAIL=admin@zupirus.com
ADMIN_PASSWORD=your_secure_admin_password_here
FEED_TOKEN=your_secure_feed_token_here

# --- Quantitative Research & WFO Guardrails ---
AUTO_ATTACH_ATR_SL=true
MAX_ENTRY_SLIPPAGE_PIPS=3.0
# Minimum trade samples before Tabula Rasa inductive learning activates
MIN_INDUCTIVE_SAMPLES=30
# Walk-Forward Optimization (WFO) roundtrip friction cost in pips (Spread + Commission + Slippage)
WFO_ROUNDTRIP_COST_PIPS=3.5
# Commercial PDF report checkout flag (defaults to false for safety)
COMMERCIAL_REPORTS_SALE_ENABLED=false

# --- AI Intelligence & Ingestion Pool ---
GEMINI_API_KEYS=key1,key2,key3
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=zupirus-quant-lab
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=

# --- Email Notifications (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=ZUPIRUS Quant Lab <system@zupirus.com>

# --- SePay VietQR Billing Automation ---
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
FALLBACK_USD_VND_RATE=25500
FX_RATE_PROVIDER_URL=
FX_RATE_CACHE_TTL_SECONDS=1800

# --- Direct On-Chain Cryptocurrency Payments (USDT TRC20 & BEP20 to Admin Wallets) ---
# Zero intermediary fees. Configured dynamically via Admin Portal > Billing & Wallets (KV store).

# --- Webhooks (TradingView / Inbound) ---
TRADINGVIEW_WEBHOOK_SECRET=

# --- Semantic RAG & Observability (v1.1) ---
ENABLE_PGVECTOR=true
SENTRY_DSN=
