# ==============================================================================
# ZUPIRUS Quant Lab — Cấu hình Môi trường Mẫu (.env.example)
# ==============================================================================
# Toàn bộ hệ thống trong giai đoạn nghiệm thu bắt buộc chạy ở SIMULATION_ONLY.
EXECUTION_MODE=SIMULATION_ONLY

# Cấu hình máy chủ HTTP
PORT=3000
HOST=0.0.0.0

# Thư mục lưu trạng thái bền vững (quant-state.json, journal.ndjson, ticks-batches.ndjson)
DATA_DIR=./data/runtime

# Đường dẫn bộ dữ liệu phát lại xác định XAUUSD M15 và file tick nhị phân tùy chọn
REPLAY_FILE=./data/xauusd_m15_replay.json
TICKS_FILE=

# Nhịp chạy vòng lặp phát lại tự động (mili giây trên mỗi nến M15)
REPLAY_INTERVAL_MS=800
AUTO_START_LOOP=true

# Phân quyền RBAC & Xác thực API (ADMIN / VIEWER / COLLECTOR)
ENFORCE_STRICT_AUTH=false
ADMIN_AUTH_TOKEN=zupirus-admin-demo-token
VIEWER_AUTH_TOKEN=zupirus-viewer-demo-token
COLLECTOR_AUTH_TOKEN=zupirus-collector-demo-token

# Cấu hình bộ thu MT5 Demo trên máy Windows (scripts/record-mt5-demo.py)
ZUPIRUS_SERVER_URL=http://127.0.0.1:3100
ZUPIRUS_SPOOL_DB=./data/mt5_ticks_spool.sqlite
ZUPIRUS_SYMBOL=XAUUSD
ZUPIRUS_COLLECTOR_ID=WIN-MT5-DEMO-01