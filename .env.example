# ==============================================================================
# ZUPIRUS Quant Lab — Cấu hình Môi trường Mẫu (.env.example)
# Kiến trúc: PostgreSQL + TimescaleDB, Redis, LangSmith, Vercel AI SDK 6
# ==============================================================================

# Khởi tạo thông tin quản trị viên (Admin)
ADMIN_EMAIL=admin@zupirus.local
ADMIN_PASSWORD=

# Token nạp dữ liệu giá MT5 Windows (Feeder)
FEED_TOKEN=

# Chế độ triển khai (replay = localhost/loopback; public = HTTPS hai tên miền zupirus.com & adm.zupirus.com)
DEPLOY_MODE=replay
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,https://zupirus.com,https://adm.zupirus.com
ACME_EMAIL=admin@zupirus.com

# ------------------------------------------------------------------------------
# 1. Cơ sở Dữ liệu Chính: PostgreSQL + TimescaleDB
# ------------------------------------------------------------------------------
POSTGRES_DB=zupirus
POSTGRES_USER=zupirus
POSTGRES_PASSWORD=zupirus_master_secret
DATABASE_URL=postgresql://zupirus:zupirus_master_secret@timescaledb:5432/zupirus

# ------------------------------------------------------------------------------
# 2. Hàng đợi Tín hiệu Thời gian thực & Khóa Phân tán: Redis
# ------------------------------------------------------------------------------
REDIS_PASSWORD=zupirus_redis_secret
REDIS_URL=redis://:zupirus_redis_secret@redis:6379/0

# ------------------------------------------------------------------------------
# 3. Giám sát & Tracing AI Toàn diện: LangSmith
# ------------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=zupirus-quant-lab
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# 4. Tích hợp AI / Vercel AI SDK 6 Backend
# ------------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Dịch vụ cung cấp giá MT5 trên Windows:
API_URL=https://zupirus.com
MT5_SYMBOL=XAUUSD
